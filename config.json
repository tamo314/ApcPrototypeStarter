{
  "project_dir": ".",
  "executor": "antigravity",
  "max_iterations": 20,
  "executor_timeout_seconds": 7200,
  "planner_timeout_seconds": 1200,
  "max_result_chars_for_planner": 60000,
  "recent_history_items_for_planner": 4,
  "stop_on_executor_error": true,
  "codex": {
    "command": "codex",
    "extra_args": []
  },
  "claude": {
    "command": "claude",
    "model": "gpt-5.6-terra",
    "extra_args": [
      "--output-format",
      "json",
      "--max-turns",
      "20"
    ]
  },
  "antigravity": {
    "command": "agy",
    "extra_args": [
      "--print-timeout",
      "60m",
      "--output-format",
      "stream-json"
    ]
  },
  "codex": {
    "command": "codex",
    "model": "",
    "extra_args": [],

    "executor_model": "",
    "executor_sandbox": "workspace-write",
    "executor_approval_policy": "never",
    "executor_extra_args": [
      "--config",
      "sandbox_workspace_write.network_access=true"
    ]
  }
}
